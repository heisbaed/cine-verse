{
  "hosting": [
    {
      "target": "mainsite",
      "public": "dist",
      "ignore": [
        "firebase.release.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=0,must-revalidate"
            }
          ]
        },
        {
          "source": "/download",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=0,must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "target": "alternate",
      "public": "dist",
      "ignore": [
        "firebase.release.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=0,must-revalidate"
            }
          ]
        },
        {
          "source": "/download",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=0,must-revalidate"
            }
          ]
        }
      ]
    }
  ]
}
