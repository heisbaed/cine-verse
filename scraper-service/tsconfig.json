{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/index.ts", "src/types.ts", "src/signing.ts", "src/proxy.ts", "src/resolvers/**/*.ts", "src/adapters/upstreamA.ts", "test/**/*.ts"]
}
